config_version=5

[application]
config/name="Firedriver · Little acts of heroism"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
rendering_device/driver.macos="metal"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.web=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.64,0.8,0.84,1)

[input_devices]
pointing/emulate_mouse_from_touch=false

[physics]
common/physics_ticks_per_second=60
common/physics_interpolation=true
3d/default_gravity=20.0

[layer_names]
3d_physics/layer_3="Ladder events"
3d_physics/layer_4="Visible driving surfaces"
3d_physics/layer_5="Neighbour personal space"
3d_physics/layer_6="Play-mat boundary"
